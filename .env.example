# Çocuk Video Stüdyosu — ortam değişkenleri
# Bu dosyayı .env olarak kopyala ve kendi anahtarını yaz:
#   cp .env.example .env

# Zorunlu: Claude (Anthropic) API anahtarı — hikaye yazımı ve sahne illüstrasyonu için.
# https://console.anthropic.com/settings/keys adresinden alabilirsin.
ANTHROPIC_API_KEY=

# İsteğe bağlı: senaryo ve illüstrasyon için kullanılacak Claude modelleri.
KIDS_SCRIPT_MODEL=claude-opus-5-5
KIDS_IMAGE_MODEL=claude-sonnet-5-5

# İsteğe bağlı: seslendirme motoru. edge = ücretsiz, anahtar gerekmez, 75+ dil.
TTS_ENGINE=edge
